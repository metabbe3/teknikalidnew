services:
  app:
    build:
      context: .
      args:
        - NEXT_PUBLIC_CRYPTO_ENABLED=${NEXT_PUBLIC_CRYPTO_ENABLED:-}
    ports:
      - "3000:3000"
    environment:
      - DATABASE_URL=${DOCKER_DATABASE_URL:-postgresql://teknikalid:teknikalid_secret_2024@db:5432/teknikalid}
      - AUTH_SECRET=${AUTH_SECRET:?AUTH_SECRET is required}
      - AUTH_URL=${AUTH_URL:-https://teknikal.id}
      - AUTH_TRUST_HOST=true
      - GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID:-}
      - GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET:-}
      - CRON_SECRET=${CRON_SECRET:-}
      - ANTHROPIC_AUTH_TOKEN=${ANTHROPIC_AUTH_TOKEN:-}
      - ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL:-}
      - ANTHROPIC_MODEL=${ANTHROPIC_MODEL:-glm-5.1}
      - API_TIMEOUT_MS=${API_TIMEOUT_MS:-300000}
      - SENTRY_DSN=${SENTRY_DSN:-}
      - NEXT_PUBLIC_CRYPTO_ENABLED=${NEXT_PUBLIC_CRYPTO_ENABLED:-}
      - COMFYUI_URL=${COMFYUI_URL:-http://127.0.0.1:8188}
      - COMFYUI_OUTPUT_DIR=${COMFYUI_OUTPUT_DIR:-/opt/comfyui/output}
      - MIDTRANS_MERCHANT_ID=${MIDTRANS_MERCHANT_ID:-}
      - MIDTRANS_CLIENT_KEY=${MIDTRANS_CLIENT_KEY:-}
      - MIDTRANS_SERVER_KEY=${MIDTRANS_SERVER_KEY:-}
      - MIDTRANS_IS_PRODUCTION=${MIDTRANS_IS_PRODUCTION:-false}
      # Cap heap below the 2G container limit — saw a heap-FATAL crash 2026-09-07.
      - NODE_OPTIONS=--max-old-space-size=1536
    volumes:
      - comfyui_images:/opt/comfyui/output
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2G
        reservations:
          memory: 512M
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    command: >
      sh -c "node node_modules/prisma/build/index.js migrate deploy && node custom-server.js"
    networks:
      - internal

  worker:
    build:
      context: .
      target: builder
    environment:
      - DATABASE_URL=${DOCKER_DATABASE_URL:-postgresql://teknikalid:teknikalid_secret_2024@db:5432/teknikalid}
      - NODE_ENV=production
      - ANTHROPIC_AUTH_TOKEN=${ANTHROPIC_AUTH_TOKEN:-}
      - ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL:-}
      - ANTHROPIC_MODEL=${ANTHROPIC_MODEL:-glm-5.1}
      - API_TIMEOUT_MS=${API_TIMEOUT_MS:-300000}
      - SITE_URL=${SITE_URL:-http://app:3000}
      - CRON_SECRET=${CRON_SECRET:-}
    command: ["npx", "tsx", "src/worker/agent-worker.ts"]
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
        reservations:
          memory: 256M
    # Event-loop liveness probe (ops-2026-09-22-01): worker heartbeats to
    # /tmp/worker-heartbeat every 60s while its event loop runs — long async/await
    # LLM jobs never pause it. A frozen loop (SIGSTOP, sync hang) lets the file go
    # stale >180s. On stale the probe pkills the real worker processes, NOT PID 1:
    # SIGKILL to PID 1 from inside the PID namespace is silently IGNORED by the
    # kernel (verified 22 Sep), and `restart: unless-stopped` only reacts to
    # container EXIT, not an unhealthy label. `agent-worke[r]` (bracket =
    # self-exclusion) ends npm's child → npm exits → container exits → restart
    # policy revives it.
    healthcheck:
      test: ["CMD-SHELL", "node -e \"const fs=require('fs');let stale=true;try{stale=Date.now()-fs.statSync('/tmp/worker-heartbeat').mtimeMs>180000}catch(e){};if(stale){try{require('child_process').execSync(\\\"pkill -9 -f 'agent-worke[r]'\\\")}catch(e){}}process.exit(stale?1:0)\""]
      interval: 45s
      timeout: 10s
      retries: 3
      start_period: 90s
    networks:
      - internal

  db:
    image: postgres:16-alpine
    ports:
      - "127.0.0.1:5433:5432"
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-teknikalid}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-teknikalid_secret_2024}
      POSTGRES_DB: ${POSTGRES_DB:-teknikalid}
    volumes:
      - pgdata:/var/lib/postgresql/data
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 512M
        reservations:
          memory: 128M
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U teknikalid"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - internal

networks:
  internal:

volumes:
  pgdata:
  comfyui_images:
