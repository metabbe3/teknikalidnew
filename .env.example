# Database
DATABASE_URL="postgresql://teknikalid:teknikalid_secret@localhost:5432/teknikalid"

# ComfyUI (image generation) — run setup-comfyui.sh or set manually
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_OUTPUT_DIR=./comfyui-cache

# SEO — Google Search Console site verification code
# Get from: https://search.google.com/search-console → Settings → Verification
# Paste only the content value (e.g. GOOGLE_SITE_VERIFICATION=abc123xyz)
GOOGLE_SITE_VERIFICATION=

# Internal Analytics — IPs excluded from /admin analytics (owner/internal/monitors).
# Admin-user traffic is auto-excluded too; suspected bots are caught by behavior.
# Comma-separated, e.g. ANALYTICS_EXCLUDE_IPS=1.2.3.4,5.6.7.8
ANALYTICS_EXCLUDE_IPS=
